# Optional — used as a fallback for BMR estimation before onboarding
# completes in the app UI. Once onboarding is done, the stored profile
# takes precedence.
USER_WEIGHT_KG=65
USER_HEIGHT_CM=165
USER_AGE=30
USER_SEX=female

# Required only if you want to use the "Connect Strava account" option
# (the CSV export-upload option works without these). Create an API app at
# https://www.strava.com/settings/api — set "Authorization Callback Domain"
# to "localhost".
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional — only used when a logged food doesn't match anything in
# data/food_db.json (e.g. an Indian dish not yet in the curated list).
# If set, Groundwork asks Claude to estimate macros for that one dish —
# searching the web first for anything it isn't confident about from memory
# alone (uncommon dishes, restaurant/packaged items, etc.) — then saves the
# result into data/food_db.json, so it's matched locally (no API call) every
# time after. Leave blank to keep the app fully offline — an unmatched food
# just gets flagged "couldn't estimate" as before.
ANTHROPIC_API_KEY=

# --- The below are for hosting somewhere like Render, not local use ---
# See the "Deploying to Render" section in README.md. Leave all of these
# blank/unset for local `python app.py` runs; nothing below changes local
# behavior.

# If unset, everything runs from ./groundwork.db and ./data/ as before —
# fine locally, but wrong for a host with an ephemeral filesystem, where
# these should point at a mounted persistent disk instead (render.yaml sets
# both to /var/data automatically).
DATABASE_PATH=
DATA_DIR=

# If APP_PASSWORD is set, every route requires this HTTP Basic Auth login
# (APP_USERNAME defaults to "groundwork" if left blank). Strongly
# recommended once the app is reachable from the public internet instead of
# just home WiFi — Groundwork has no other login of its own.
APP_USERNAME=
APP_PASSWORD=
